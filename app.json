{
  "expo": {
    "name": "AAYSSA",
    "slug": "aayssa",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.aayssa.app",
      "deploymentTarget": "17.0"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "org.aayssa.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "scheme": "aayssa",
    "experiments": {
      "typedRoutes": true
    }
  }
}
